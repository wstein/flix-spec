{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "scope", "profiles"],
  "properties": {
    "schemaVersion": {"enum": [1]},
    "scope": {"enum": ["bounded-parser-cases"]},
    "profiles": {"type": "array", "minItems": 10, "maxItems": 10, "items": {"$ref": "#/definitions/profile"}}
  },
  "definitions": {
    "snapshot": {
      "type": "object", "additionalProperties": false,
      "required": ["accepted", "diagnostics", "tree"],
      "properties": {
        "accepted": {"type": "boolean"},
        "diagnostics": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "tree": {"$ref": "#/definitions/node"}
      }
    },
    "node": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["kind", "children"],
         "properties": {"kind": {"type": "string", "minLength": 1},
                        "children": {"type": "array", "items": {"$ref": "#/definitions/node"}}}},
        {"type": "object", "additionalProperties": false, "required": ["token", "text"],
         "properties": {"token": {"type": "string", "minLength": 1}, "text": {"type": "string"}}}
      ]
    },
    "sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "case": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "source", "sourceSha256", "expected", "expectedSha256"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z-]*$"},
        "source": {"type": "string", "pattern": "^profiles/sources/[a-z-]+\\.flix$"},
        "sourceSha256": {"$ref": "#/definitions/digest"},
        "expected": {"type": "string", "pattern": "^profiles/expected/0\\.[0-9]+\\.[0-9]+/[a-z-]+\\.json$"},
        "expectedSha256": {"$ref": "#/definitions/digest"}
      }
    },
    "profile": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "tag", "commit", "sources", "oracleUrl", "oracleSha256", "cases"],
      "properties": {
        "version": {"type": "string", "pattern": "^0\\.[0-9]+\\.[0-9]+$"},
        "tag": {"type": "string", "pattern": "^v0\\.[0-9]+\\.[0-9]+$"},
        "commit": {"$ref": "#/definitions/sha"},
        "sources": {"type": "object", "minProperties": 4, "additionalProperties": {"$ref": "#/definitions/sha"}},
        "oracleUrl": {"type": "string", "pattern": "^https://github\\.com/flix/flix/releases/download/v0\\.[0-9]+\\.[0-9]+/flix\\.jar$"},
        "oracleSha256": {"$ref": "#/definitions/digest"},
        "cases": {"type": "array", "minItems": 9, "items": {"$ref": "#/definitions/case"}}
      }
    }
  }
}
