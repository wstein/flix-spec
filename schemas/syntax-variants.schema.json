{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Bounded syntax production variant catalogue",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "upstreamCommit", "upstreamTag", "scope", "variants"],
  "properties": {
    "schemaVersion": {"enum": [1]},
    "upstreamCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "upstreamTag": {"type": "string", "minLength": 1},
    "scope": {"type": "string", "minLength": 1},
    "variants": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/variant"}}
  },
  "definitions": {
    "pattern": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {"type": "string", "minLength": 1},
        "token": {"type": "string", "minLength": 1},
        "text": {"type": "string"},
        "exactChildren": {"type": "boolean"},
        "firstChild": {"$ref": "#/definitions/pattern"},
        "children": {"type": "array", "items": {"$ref": "#/definitions/pattern"}},
        "descendants": {"type": "array", "items": {"$ref": "#/definitions/pattern"}}
      }
    },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["fixture", "form", "diagnostics", "matches", "absent"],
      "properties": {
        "fixture": {"type": "string", "pattern": "^fixtures/(positive|negative)/[A-Za-z0-9_/-]+\\.flix$"},
        "form": {"enum": ["raw", "normalized"]},
        "diagnostics": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["kind", "line"], "properties": {"kind": {"type": "string", "minLength": 1}, "line": {"type": "integer", "minimum": 1}}}},
        "matches": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/pattern"}},
        "absent": {"type": "array", "items": {"$ref": "#/definitions/pattern"}}
      }
    },
    "variant": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "production", "description", "upstreamSource", "evidence"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9.-]+$"},
        "production": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "upstreamSource": {"type": "string", "pattern": "^main/src/ca/uwaterloo/flix/language/phase/(Parser2|Lexer)\\.scala:[0-9]+(-[0-9]+)?$"},
        "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/evidence"}}
      }
    }
  }
}
