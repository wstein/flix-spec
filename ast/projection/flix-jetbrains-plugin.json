  "elide": [
    "Type.Type",
    "Argument",
    "Pattern.Variable",
    "Type.Argument",
    "Type.Effect",
    "Predicate.Body",
    "Expr.Expr",
    "UsesOrImports.UseOrImportList",
    "AnnotationList",
    "ModifierList",
    "Doc",
    "CommentList",
    "QName",
    "Expr.Statement",
    "Pattern.Pattern",
    "Type.Apply"
  ],
  "notes": {
    "ADDITIVE_EXPR": "Both mapped and ignored, deliberately: a pass-through on every expression without a `+`, a real binary expression when one is present. Elision fires only at arity <= 1, so the two entries describe different positions.",
    "PsiErrorElement": "IntelliJ's error node, the counterpart of the reference's ErrorTree.",
    "DECLARATION": "Flattened, not merely ignored: it groups a declaration with its doc, annotations and modifiers, which the reference makes direct children of Decl.Def. Elision only fires at arity <= 1, so without flattening its whole subtree went uncompared and depth sat at 51%."
  },
  "flatten": [
    "DECLARATION",
    "DUMMY_BLOCK"
  ]
}
