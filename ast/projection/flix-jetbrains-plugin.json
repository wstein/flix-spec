{
  "schemaVersion": 1,
  "consumer": "flix-jetbrains-plugin",
  "description": "Maps the Grammar-Kit PSI element types of wstein/flix-jetbrains-plugin onto canonical TreeKind names. Partial by design. The dominant structural difference is a precedence-chain grammar: every expression descends through roughly seventeen levels (LAZY_FORCE_EXPR, NOT_EXPR, SIGN_EXPR, ADDITIVE_EXPR, ...), each a pass-through when its operator is absent. 30% of PSI nodes are always single-child wrappers, against 11.4% on the canonical side, so most of this map is transparency rather than renaming.",
  "mappings": {
    "FILE": "Root",
    "DEF_DECL": "Decl.Def",
    "ENUM_DECL": "Decl.Enum",
    "STRUCT_DECL": "Decl.Struct",
    "TRAIT_DECL": "Decl.Trait",
    "INSTANCE_DECL": "Decl.Instance",
    "TYPE_ALIAS_DECL": "Decl.TypeAlias",
    "QUALIFIED_NAME": "QName",
    "PARAMETER_LIST": "ParameterList",
    "PARAMETER": "Parameter",
    "ARGUMENT_LIST": "ArgumentList",
    "MODIFIER_LIST": "ModifierList",
    "ANNOTATION_LIST": "AnnotationList",
    "USES_OR_IMPORTS": "UsesOrImports.UseOrImportList",
    "LITERAL_EXPR": "Expr.Literal",
    "INFIX_APP_EXPR": "Expr.Binary",
    "ADDITIVE_EXPR": "Expr.Binary",
    "MULTIPLICATIVE_EXPR": "Expr.Binary",
    "RELATIONAL_EXPR": "Expr.Binary",
    "EQUALITY_EXPR": "Expr.Binary",
    "AND_EXPR": "Expr.Binary",
    "OR_EXPR": "Expr.Binary",
    "USER_OP_EXPR": "Expr.Binary",
    "CONS_EXPR": "Expr.Binary",
    "NOT_EXPR": "Expr.Unary",
    "SIGN_EXPR": "Expr.Unary",
    "STATEMENT": "Expr.Statement",
    "TYPE": "Type.Type",
    "ARROW_TYPE": "Type.Function",
    "TYPE_APPLICATION": "Type.Apply",
    "PsiErrorElement": "ErrorTree",
    "USE_DECL": "UsesOrImports.Use"
  },
  "ignored": [
    "ADDITIVE_EXPR",
    "ADD_SUB_TYPE",
    "AMP_TYPE",
    "AND_EXPR",
    "AND_TYPE",
    "ANNOTATION_LIST",
