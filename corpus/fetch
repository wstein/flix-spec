#!/usr/bin/env bash
# Fetches the pinned Flix source corpus from upstream, verifies its git tree hash
# and file counts according to corpus/corpus.json and pin.json.
#
# Implementation plan section 5.2: the corpus definition is a day-one deliverable.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PIN="$ROOT/pin.json"
CORPUS_SPEC="$ROOT/corpus/corpus.json"
DEST_DIR="$ROOT/.oracle/flix-repo"

COMMIT="$(jq -r '.upstream.commit' "$PIN")"
TREE_HASH="$(jq -r '.upstream.treeHash' "$PIN")"
EXPECT_TOTAL="$(jq -r '.counts.totalFlixFiles' "$CORPUS_SPEC")"
EXPECT_MAIN="$(jq -r '.counts.mainFlixFiles' "$CORPUS_SPEC")"

if [ ! -d "$DEST_DIR/.git" ]; then
  echo "Cloning upstream flix repository at commit $COMMIT..."
  mkdir -p "$DEST_DIR"
  git clone --quiet https://github.com/flix/flix.git "$DEST_DIR"
fi

# HEAD's tree hash says nothing about modified working-tree files. Refuse local
# edits rather than report a verified corpus that the parser will read differently.
if ! git -C "$DEST_DIR" diff --quiet HEAD --; then
  echo "FATAL: corpus checkout has tracked local changes: $DEST_DIR" >&2
  echo "Preserve or revert those changes before fetching the pinned corpus." >&2
  exit 1
fi

# Reachability walks the working tree, including files ignored by Git. An extra
# source must not become part of the measured corpus just because counts match.
if [ -n "$(git -C "$DEST_DIR" ls-files --others -- '*.flix')" ]; then
  echo "FATAL: corpus checkout has untracked .flix files: $DEST_DIR" >&2
  echo "Move those files out of the corpus before fetching the pin." >&2
  exit 1
fi

# An existing corpus clone may predate this pin bump. Fetch only when the pinned
# commit is missing so verified local checkouts remain usable offline.
if ! git -C "$DEST_DIR" cat-file -e "${COMMIT}^{commit}" 2>/dev/null; then
  git -C "$DEST_DIR" fetch --quiet https://github.com/flix/flix.git "$COMMIT"
fi

echo "Checking out $COMMIT in $DEST_DIR..."
git -C "$DEST_DIR" checkout --quiet "$COMMIT"

ACTUAL_COMMIT="$(git -C "$DEST_DIR" rev-parse HEAD)"
if [ "$ACTUAL_COMMIT" != "$COMMIT" ]; then
  echo "FATAL: corpus commit mismatch" >&2
  echo "  expected: $COMMIT" >&2
  echo "  actual:   $ACTUAL_COMMIT" >&2
  exit 1
fi

ACTUAL_TREE_HASH="$(git -C "$DEST_DIR" rev-parse "HEAD^{tree}")"
if [ "$ACTUAL_TREE_HASH" != "$TREE_HASH" ]; then
  echo "FATAL: corpus git tree hash mismatch" >&2
  echo "  expected: $TREE_HASH" >&2
  echo "  actual:   $ACTUAL_TREE_HASH" >&2
  exit 1
fi

ACTUAL_TOTAL="$(find "$DEST_DIR" -type f -name '*.flix' | wc -l | tr -d ' ')"
ACTUAL_MAIN="$(find "$DEST_DIR/main" -type f -name '*.flix' | wc -l | tr -d ' ')"

if [ "$ACTUAL_TOTAL" -ne "$EXPECT_TOTAL" ]; then
  echo "FATAL: total .flix file count mismatch" >&2
  echo "  expected: $EXPECT_TOTAL" >&2
  echo "  actual:   $ACTUAL_TOTAL" >&2
  exit 1
fi

if [ "$ACTUAL_MAIN" -ne "$EXPECT_MAIN" ]; then
  echo "FATAL: main .flix file count mismatch" >&2
  echo "  expected: $EXPECT_MAIN" >&2
  echo "  actual:   $ACTUAL_MAIN" >&2
  exit 1
fi

echo "Verified corpus at $DEST_DIR:"
echo "  commit:    $ACTUAL_COMMIT"
echo "  treeHash:  $ACTUAL_TREE_HASH"
echo "  totalFlix: $ACTUAL_TOTAL"
echo "  mainFlix:  $ACTUAL_MAIN"
